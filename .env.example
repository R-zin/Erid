# Example environment for the AI Context Hub self-host stack (docker-compose.yml).
# Copy to `.env` and fill in real values: `cp .env.example .env`
# Compose reads `.env` automatically; every value below is optional unless noted.

# --- MCP worker (mcp-server service, --profile mcp) -------------------------
# Workspace the MCP worker joins.
WORKSPACE_SLUG=erid
# Auth for the MCP worker against the workspace: use ONE of these.
# An X-API-Key (workspace key or per-actor key) ...
WORKSPACE_API_KEY=
# ... or a pre-minted JWT access token.
WORKSPACE_TOKEN=

# --- Access control (api) ----------------------------------------------------
# Whether "open" workspaces are allowed: a workspace with no key at all, created
# implicitly the first time any slug is requested, granting full access without
# credentials. That is the zero-config local-dev flow and defaults to ON.
#
# Set to 0 on any deployment strangers can reach. Closed mode:
#   * an unknown slug returns 404 instead of being created, so nobody can grow
#     the workspaces table or squat a slug your team hasn't provisioned yet;
#   * an existing keyless workspace grants nothing anonymously;
#   * POST /api/workspaces/{slug}/secure no longer hands the owner key to the
#     first caller — provision with POST /api/workspaces?slug= instead, which
#     mints a key up front.
ERID_ALLOW_OPEN_WORKSPACES=1

# Operator secret. When set, POST /api/workspaces (which mints a workspace and
# its owner key) requires header `X-Admin-Token: <this value>`. Required by the
# production overlay. Generate with: `openssl rand -hex 32`
ERID_ADMIN_TOKEN=
# Whether GET /api/workspaces lists all workspace slugs anonymously. Set to 0 so
# tenants can't enumerate each other; the listing then needs X-Admin-Token.
ERID_PUBLIC_WORKSPACE_DIRECTORY=1

# --- Production mode, scaling and hardening (api) ----------------------------
# Full reference: docs/production.md.
# "production" (the prod overlay sets it) refuses to start with an unsafe
# configuration: open workspaces, a short/missing admin token, no JWT keypair,
# OAuth without a session secret, CORS '*', or rate limits off.
# (ERID_ENV=prod below also selects the overlay in infra/deploy.sh.)
# Rate limits ("<count>/<second|minute|hour>", 0 disables):
ERID_RATE_LIMIT_AUTH=30/minute
ERID_RATE_LIMIT_AUTH_FAILURES=20/minute
ERID_RATE_LIMIT_API=1200/minute
# Per-replica load shedding (503 + Retry-After / WebSocket close 1013).
ERID_MAX_INFLIGHT_REQUESTS=256
ERID_MAX_WEBSOCKETS=2000
# Request body limit in bytes.
ERID_MAX_BODY_BYTES=1048576
# Secret scanning on writes: redact | reject | off.
ERID_SECRET_SCANNING=redact
# Database pool per replica; budget replicas x (size + overflow) + 1.
ERID_DB_POOL_SIZE=10
ERID_DB_MAX_OVERFLOW=10
# Behind PgBouncer (transaction mode): set both.
# ERID_DB_PGBOUNCER=1
# ERID_DIRECT_DATABASE_URL=postgresql+asyncpg://user:pass@postgres-direct:5432/erid
# Bearer token for GET /metrics (Prometheus). Empty leaves it open.
ERID_METRICS_TOKEN=
# Number of API replicas in the prod overlay (behind Caddy).
ERID_API_REPLICAS=2

# --- Production overlay (docker-compose.prod.yml) ----------------------------
# Public hostname; Caddy fetches a TLS certificate for it. DNS must point here.
ERID_DOMAIN=
# Postgres superuser password (applied when the data volume is first created).
POSTGRES_PASSWORD=
# Set to `prod` so infra/deploy.sh uses the production overlay.
ERID_ENV=

# --- Session / JWT -----------------------------------------------------------
# Secret for signing web session/state cookies. Required once OAuth is enabled.
# Generate with: `openssl rand -hex 32`
ERID_SESSION_SECRET=

# Ed25519 (EdDSA) keypair for signing/verifying JWT access tokens. PEM-encoded.
# Provide BOTH for stable tokens across restarts; if unset, the API generates an
# ephemeral pair at startup and all tokens die on restart. Generate a pair with:
#   openssl genpkey -algorithm ed25519 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
# then paste the PEM blocks as single-line env values (\n between lines, or
# base64 the whole PEM if your tooling prefers).
ERID_JWT_PRIVATE_KEY=
ERID_JWT_PUBLIC_KEY=

# --- OAuth providers (api) ---------------------------------------------------
# Base URLs used to build callback links and post-login redirects.
ERID_OAUTH_REDIRECT_BASE=http://localhost:8000
ERID_OAUTH_WEB_BASE=http://localhost:8080
# Lifetime (seconds) of an OAuth invitation that lets a new Google/GitHub login
# join a *secured* workspace as a pre-created actor. Default 7 days.
ERID_OAUTH_INVITE_TTL_SECONDS=604800

# Google Cloud (APIs & Services -> Credentials -> OAuth 2.0 Client ID, Web).
# Authorized redirect URI: ${ERID_OAUTH_REDIRECT_BASE}/api/auth/google/callback
ERID_OAUTH_GOOGLE_CLIENT_ID=
ERID_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub (Settings -> Developer settings -> OAuth Apps -> New OAuth App).
# Authorization callback URL: ${ERID_OAUTH_REDIRECT_BASE}/api/auth/github/callback
ERID_OAUTH_GITHUB_CLIENT_ID=
ERID_OAUTH_GITHUB_CLIENT_SECRET=
