# Example environment for the AI Context Hub self-host stack (docker-compose.yml).
# Copy to `.env` and fill in real values: `cp .env.example .env`
# Compose reads `.env` automatically; every value below is optional unless noted.

# --- MCP worker (mcp-server service, --profile mcp) -------------------------
# Workspace the MCP worker joins.
WORKSPACE_SLUG=erid
# Auth for the MCP worker against the workspace: use ONE of these.
# An X-API-Key (workspace key or per-actor key) ...
WORKSPACE_API_KEY=
# ... or a pre-minted JWT access token.
WORKSPACE_TOKEN=

# --- Session / JWT -----------------------------------------------------------
# Secret for signing web session/state cookies. Required once OAuth is enabled.
# Generate with: `openssl rand -hex 32`
ERID_SESSION_SECRET=

# Ed25519 (EdDSA) keypair for signing/verifying JWT access tokens. PEM-encoded.
# Provide BOTH for stable tokens across restarts; if unset, the API generates an
# ephemeral pair at startup and all tokens die on restart. Generate a pair with:
#   openssl genpkey -algorithm ed25519 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
# then paste the PEM blocks as single-line env values (\n between lines, or
# base64 the whole PEM if your tooling prefers).
ERID_JWT_PRIVATE_KEY=
ERID_JWT_PUBLIC_KEY=

# --- OAuth providers (api) ---------------------------------------------------
# Base URLs used to build callback links and post-login redirects.
ERID_OAUTH_REDIRECT_BASE=http://localhost:8000
ERID_OAUTH_WEB_BASE=http://localhost:8080

# Google Cloud (APIs & Services -> Credentials -> OAuth 2.0 Client ID, Web).
# Authorized redirect URI: ${ERID_OAUTH_REDIRECT_BASE}/api/auth/google/callback
ERID_OAUTH_GOOGLE_CLIENT_ID=
ERID_OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub (Settings -> Developer settings -> OAuth Apps -> New OAuth App).
# Authorization callback URL: ${ERID_OAUTH_REDIRECT_BASE}/api/auth/github/callback
ERID_OAUTH_GITHUB_CLIENT_ID=
ERID_OAUTH_GITHUB_CLIENT_SECRET=
